GOOGLE_API_KEY=your-google-generative-ai-api-key-here

# Optional. Unset (the default) disables the /query and /papers auth check entirely --
# see require_api_key() in backend/main.py. Must match the frontend's VITE_API_KEY.
# API_KEY=

# Optional overrides -- see config.py for all defaults (CORS origins, rate limits, etc).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RATE_LIMIT_QUERY=5/hour
# RATE_LIMIT_DEFAULT=60/minute
